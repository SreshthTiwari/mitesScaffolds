# Copy this file to ".env" and fill in your key. NEVER commit ".env" to git.
# If the key is left empty, the app still runs in DEMO mode (no real AI).
GEMINI_API_KEY=

# Optional: which model to use (see https://ai.google.dev/gemini-api/docs/models for current model names)
LLM_MODEL=gemini-3.5-flash
